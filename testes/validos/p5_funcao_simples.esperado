[OK] return reconhecido
[OK] def reconhecido
[OK] chamada de funcao reconhecida
[OK] atribuicao reconhecida
[OK] chamada de funcao reconhecida
PROGRAMA [linha 2]
  FUNCAO 'soma' [linha 2]
    PARAMETRO 'a' [linha 2]
    PARAMETRO 'b' [linha 2]
    BLOCO [linha 2]
      RETURN [linha 3]
        SOMA [linha 3]
          IDENTIFICADOR 'a' [linha 3]
          IDENTIFICADOR 'b' [linha 3]
  ATRIBUICAO [linha 5]
    IDENTIFICADOR 'resultado' [linha 5]
    CHAMADA 'soma' [linha 5]
      NUMERO 2 [linha 5]
      NUMERO 3 [linha 5]
  CHAMADA 'print' [linha 6]
    IDENTIFICADOR 'resultado' [linha 6]
