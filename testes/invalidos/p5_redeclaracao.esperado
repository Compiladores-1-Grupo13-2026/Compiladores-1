PROGRAMA [linha 1]
  FUNCAO 'f' [linha 1]
    PARAMETRO 'a' [linha 1]
    PARAMETRO 'a' [linha 1]
    BLOCO [linha 1]
      RETURN [linha 1]
        IDENTIFICADOR 'a' [linha 1]
  FUNCAO 'g' [linha 2]
    BLOCO [linha 2]
      RETURN [linha 2]
        NUMERO 1 [linha 2]
  FUNCAO 'g' [linha 3]
    BLOCO [linha 3]
      RETURN [linha 3]
        NUMERO 2 [linha 3]
  FUNCAO 'print' [linha 4]
    PARAMETRO 'texto' [linha 4]
    BLOCO [linha 4]
      RETURN [linha 4]
        IDENTIFICADOR 'texto' [linha 4]
