PROGRAMA [linha 1]
  FUNCAO 'soma' [linha 1]
    PARAMETRO 'a' [linha 1]
    PARAMETRO 'b' [linha 1]
    BLOCO [linha 1]
      RETURN [linha 1]
        SOMA [linha 1]
          IDENTIFICADOR 'a' [linha 1]
          IDENTIFICADOR 'b' [linha 1]
  CHAMADA 'soma' [linha 2]
    NUMERO 1 [linha 2]
  CHAMADA 'soma' [linha 3]
    NUMERO 1 [linha 3]
    NUMERO 2 [linha 3]
    NUMERO 3 [linha 3]
  FOR 'i' [linha 4]
    CHAMADA 'range' [linha 4]
    BLOCO [linha 4]
      CHAMADA 'print' [linha 4]
        IDENTIFICADOR 'i' [linha 4]
  ATRIBUICAO [linha 5]
    IDENTIFICADOR 'x' [linha 5]
    NUMERO 5 [linha 5]
  CHAMADA 'x' [linha 6]
    NUMERO 1 [linha 6]
